<?xml version="1.0" ?>
<!DOCTYPE fontconfig
  SYSTEM 'urn:fontconfig:fonts.dtd'>
<fontconfig>
  <include>/etc/fonts/fonts.conf</include>
  <dir>/usr/local/share/fonts/word-mac</dir>
  <cachedir>/var/cache/fontconfig</cachedir>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正小标宋简体</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>FZXiaoBiaoSong-B05S</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <!-- Matches the fallback observed in Mac Word's reference PDFs. -->
  <match target="pattern">
    <test name="family" compare="eq"><string>方正小标宋_GBK</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Microsoft YaHei</string></edit>
  </match>
  <!-- Matches the fallback observed in Mac Word's reference PDFs. -->
  <match target="pattern">
    <test name="family" compare="eq"><string>方正黑体_GBK</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Microsoft YaHei</string></edit>
  </match>
  <!-- Matches the fallback observed in Mac Word's reference PDFs. -->
  <match target="pattern">
    <test name="family" compare="eq"><string>方正黑体简体</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Microsoft YaHei</string></edit>
  </match>
  <!-- Matches the fallback observed in Mac Word's reference PDFs. -->
  <match target="pattern">
    <test name="family" compare="eq"><string>方正楷体_GBK</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Microsoft YaHei</string></edit>
  </match>
  <!-- Matches the fallback observed in Mac Word's reference PDFs. -->
  <match target="pattern">
    <test name="family" compare="eq"><string>方正楷体简体</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Microsoft YaHei</string></edit>
  </match>
  <!-- Matches the fallback observed in Mac Word's reference PDFs. -->
  <match target="pattern">
    <test name="family" compare="eq"><string>方正仿宋_GBK</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Microsoft YaHei</string></edit>
  </match>
</fontconfig>
