<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" compare="eq" qual="first">
      <string>sans-serif</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Times New Roman</string>
      <string>SimSun</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq" qual="first">
      <string>monospace</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Times New Roman</string>
      <string>SimSun</string>
    </edit>
  </match>
  <include>/etc/fonts/fonts.conf</include>
  <dir>/usr/local/share/fonts/word-mac</dir>
  <cachedir>/var/cache/fontconfig</cachedir>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正小标宋简体</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>FZXiaoBiaoSong-B05S</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正小标宋_GBK</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正黑体_GBK</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正黑体简体</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正楷体_GBK</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正楷体简体</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正仿宋_GBK</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>文星仿宋</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>文星标宋</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>文星楷体</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>文星黑体</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>CESI宋体-GB2312</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>方正书宋_GBK</string>
    </test>
    <edit name="family" mode="assign" binding="strong">
      <string>Microsoft YaHei</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq" qual="first">
      <string>Helvetica</string>
    </test>
    <edit name="family" mode="append" binding="strong">
      <string>SimSun</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq" qual="first">
      <string>Menlo</string>
    </test>
    <edit name="family" mode="append" binding="strong">
      <string>SimSun</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" qual="first" compare="eq">
      <string>Aptos</string>
    </test>
    <edit name="family" mode="append" binding="strong">
      <string>Apple Color Emoji</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" qual="first" compare="eq">
      <string>DengXian</string>
    </test>
    <edit name="family" mode="append" binding="strong">
      <string>Apple Color Emoji</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" qual="first" compare="eq">
      <string>DengXian Light</string>
    </test>
    <edit name="family" mode="append" binding="strong">
      <string>Apple Color Emoji</string>
    </edit>
  </match>
</fontconfig>
